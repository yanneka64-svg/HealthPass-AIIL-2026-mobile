# URL du déploiement "Exécuter en tant que : Moi / Qui a accès : Tout le monde"
# du Web App Apps Script (Code_v3_3_0.gs). Voir README.md.
EXPO_PUBLIC_HEALTHPASS_API_URL=https://script.google.com/macros/s/REMPLACER_PAR_TON_ID_DE_DEPLOIEMENT/exec

# Client OAuth "Web application" Google Cloud — DOIT être exactement le même
# ID que la propriété de script GOOGLE_OAUTH_CLIENT_ID côté Apps Script
# (celui déjà utilisé par le Control Panel desktop). Voir README.md,
# section "Google Sign-In (Superviseur)".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REMPLACER_PAR_LE_CLIENT_ID.apps.googleusercontent.com
