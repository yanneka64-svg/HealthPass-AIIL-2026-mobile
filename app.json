{
  "expo": {
    "name": "Activa HealthPass",
    "slug": "activa-healthpass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "healthpass",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.groupactiva.healthpass"
    },
    "android": {
      "package": "com.groupactiva.healthpass",
      "adaptiveIcon": {
        "backgroundColor": "#0D3F8F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Utilisé pour sécuriser votre session HealthPass."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
